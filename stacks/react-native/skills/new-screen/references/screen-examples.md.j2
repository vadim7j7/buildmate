import { useBudget, useCreateBudget, useUpdateBudget } from '@/queries/useBudgets';
import { {{ field }} } from '@/components/{{ field_path }}';
import { CurrencyInput } from '@/components/forms/CurrencyInput';

export default function BudgetFormScreen() {
  const { t } = useTranslation();
  const { id } = useLocalSearchParams<{ id?: string }>();
  const { data: existing } = useBudget(id ?? '', { enabled: !!id });
  const createMutation = useCreateBudget();
  const updateMutation = useUpdateBudget();

  // Initialise from the loaded record; the form owns the draft after that
  const [name, setName] = useState(existing?.name ?? '');
  const [amount, setAmount] = useState(existing?.amount ?? 0);

  const errors: Record<string, string> = {};
  if (!name.trim()) errors.name = t('budgets.validation.nameRequired');
  if (amount <= 0) errors.amount = t('budgets.validation.amountPositive');
  const isValid = Object.keys(errors).length === 0;
  const isSaving = createMutation.isPending || updateMutation.isPending;

  const handleSave = async () => {
    if (!isValid || isSaving) return;
    try {
      if (id) await updateMutation.mutateAsync({ id, name, amount });
      else await createMutation.mutateAsync({ name, amount });
      router.back();
    } catch {
      Alert.alert(t('common.error'), t('budgets.saveFailed'));
    }
  };

  return (
    <KeyboardAvoidingView
      className="flex-1 {{ c.bg }}"
      behavior={Platform.OS === 'ios' ? 'padding' : 'height'}
    >
      <Stack.Screen
        options={{ '{{' }}
          title: id ? t('budgets.edit') : t('budgets.create'),
          headerRight: () => (
            <Pressable onPress={handleSave} disabled={!isValid || isSaving} accessibilityRole="button">
              <Text className={!isValid || isSaving ? 'font-semibold opacity-40 {{ c.primary }}' : 'font-semibold {{ c.primary }}'}>
                {isSaving ? t('common.saving') : t('common.save')}
              </Text>
            </Pressable>
          ),
        {{ '}}' }}
      />
      <ScrollView contentContainerClassName="gap-4 p-4" keyboardShouldPersistTaps="handled">
        <{{ field }}
          label={t('budgets.name')}
          value={name}
          onChangeText={setName}
          error={errors.name}
          autoFocus={!id}
          testID="budget-name-input"
        />
        <CurrencyInput
          label={t('budgets.amount')}
          value={amount}
          onChangeValue={setAmount}
          error={errors.amount}
          testID="budget-amount-input"
        />
      </ScrollView>
    </KeyboardAvoidingView>
  );
}
```

For an edit form whose record loads after mount, render the form only once `existing`
is loaded (or key it: `<BudgetForm key={existing?.id} initial={existing} />`) instead of
copying query data into state with an effect.

