          title: budget.name,
          headerRight: () => (
            <XStack gap="$sm">
              <IconButton icon="pencil" onPress={() => router.push(`/(modals)/budget-form?id=${budget.id}`)} />
              <IconButton icon="trash" onPress={confirmDelete} variant="danger" />
