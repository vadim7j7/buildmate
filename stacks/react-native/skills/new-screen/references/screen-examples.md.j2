## Form Screen Template

```typescript
// src/app/(modals)/budget-form.tsx
import { useState } from 'react';
import { Alert, KeyboardAvoidingView, Platform } from 'react-native';
import { Stack, router, useLocalSearchParams } from 'expo-router';
import { useTranslation } from 'react-i18next';
import { Button, ScrollView } from 'tamagui';
import { useCreateBudget, useBudget, useUpdateBudget } from '@/queries/useBudgets';
import { Input } from '@/components/ui/Input';
import { CurrencyInput } from '@/components/forms/CurrencyInput';

export default function BudgetFormScreen() {
  const { t } = useTranslation();
  const { id } = useLocalSearchParams<{ id?: string }>();
  const { data: existing } = useBudget(id ?? '', { enabled: !!id });
  const createMutation = useCreateBudget();
  const updateMutation = useUpdateBudget();

  const [name, setName] = useState(existing?.name ?? '');
  const [amount, setAmount] = useState(existing?.amount ?? 0);

  const errors: Record<string, string> = {};
  if (!name.trim()) errors.name = t('budgets.validation.nameRequired');
  if (amount <= 0) errors.amount = t('budgets.validation.amountPositive');
  const isValid = Object.keys(errors).length === 0;
  const isSaving = createMutation.isPending || updateMutation.isPending;

  const handleSave = async () => {
    if (!isValid || isSaving) return;
    try {
      if (id) await updateMutation.mutateAsync({ id, name, amount });
      else await createMutation.mutateAsync({ name, amount });
      router.back();
    } catch {
      Alert.alert(t('common.error'), t('budgets.saveFailed'));
    }
  };

  return (
    <KeyboardAvoidingView style={{ flex: 1 }} behavior={Platform.OS === 'ios' ? 'padding' : 'height'}>
      <Stack.Screen
        options={{
          title: id ? t('budgets.edit') : t('budgets.create'),
          headerRight: () => (
            <Button chromeless size="$3" disabled={!isValid || isSaving} opacity={!isValid || isSaving ? 0.4 : 1} onPress={handleSave}>
              {isSaving ? t('common.saving') : t('common.save')}
            </Button>
          ),
        }}
      />
      <ScrollView backgroundColor="$background" contentContainerStyle={{ padding: 16, gap: 16 }} keyboardShouldPersistTaps="handled">
        <Input id="budget-name" label={t('budgets.name')} value={name} onChangeText={setName}
          error={errors.name} autoFocus={!id} testID="budget-name-input" />
        <CurrencyInput label={t('budgets.amount')} value={amount} onChangeValue={setAmount}
          error={errors.amount} testID="budget-amount-input" />
      </ScrollView>
    </KeyboardAvoidingView>
  );
}
```

For an edit form whose record loads after mount, render the form only once `existing`
is loaded (or key it by id) instead of copying query data into state with an effect.

