          ),
        }}
      />
      <YStack padding="$md" borderRadius="$md" backgroundColor="$color2">
        <Paragraph size="$2" color="$color10">{t('budgets.remaining')}</Paragraph>
        <SizableText size="$8" fontWeight="700" color={remaining < 0 ? '$red10' : '$color'}>
          {remaining.toFixed(2)}
        </SizableText>
      </YStack>
      <XStack justifyContent="space-between" paddingVertical="$sm" borderBottomWidth={1} borderColor="$borderColor">
        <Paragraph color="$color10">{t('budgets.category')}</Paragraph>
        <Paragraph fontWeight="500">{t(`categories.${budget.category}`)}</Paragraph>
      </XStack>
    </ScrollView>
  );
}
