## Root Layout with Providers

```typescript
// src/app/_layout.tsx
{% if ui in ['NativeWind', 'Gluestack UI'] %}
import '@/global.css';
{% endif %}
import { useEffect } from 'react';
import { Stack } from 'expo-router';
import { QueryClientProvider } from '@tanstack/react-query';
import { SafeAreaProvider } from 'react-native-safe-area-context';
import { StatusBar } from 'expo-status-bar';
import * as SplashScreen from 'expo-splash-screen';
import { useMigrations } from 'drizzle-orm/expo-sqlite/migrator';
import { db } from '@/db/client';
import migrations from '@/db/migrations/migrations';
import { queryClient } from '@/queries/queryClient';
import '@/i18n';
{% if ui == 'Tamagui' %}
import { TamaguiProvider } from 'tamagui';
import { useColorScheme } from 'react-native';
import config from '../../tamagui.config';
{% elif ui == 'Gluestack UI' %}
import { GluestackUIProvider } from '@/components/ui/gluestack-ui-provider';
{% endif %}

SplashScreen.preventAutoHideAsync();

export default function RootLayout() {
  const { success, error } = useMigrations(db, migrations);
{% if ui == 'Tamagui' %}
  const colorScheme = useColorScheme();
{% endif %}

  useEffect(() => {
    if (success || error) SplashScreen.hideAsync();
  }, [success, error]);

  if (error) throw error;      // surfaces in the error boundary
  if (!success) return null;   // splash stays up

  return (
    <SafeAreaProvider>
      <QueryClientProvider client={queryClient}>
{% if ui == 'Tamagui' %}
        <TamaguiProvider config={config} defaultTheme={colorScheme === 'dark' ? 'dark' : 'light'}>
{% elif ui == 'Gluestack UI' %}
        <GluestackUIProvider mode="system">
{% endif %}
        <StatusBar style="auto" />
{% raw %}
        <Stack>
          <Stack.Screen name="(tabs)" options={{ headerShown: false }} />
          <Stack.Screen name="(modals)" options={{ presentation: 'modal', headerShown: false }} />
          <Stack.Screen name="+not-found" />
        </Stack>
{% endraw %}
{% if ui == 'Tamagui' %}
        </TamaguiProvider>
{% elif ui == 'Gluestack UI' %}
        </GluestackUIProvider>
{% endif %}
      </QueryClientProvider>
    </SafeAreaProvider>
  );
}
```

Auth-gated apps add `<Stack.Protected guard={isSignedIn}>` around the signed-in groups
and restore the session (status only; tokens stay in expo-secure-store) before hiding
the splash screen.

