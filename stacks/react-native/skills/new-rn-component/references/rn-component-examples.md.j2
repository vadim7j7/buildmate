## List Item Component

A FlashList row. No `React.memo`: the React Compiler memoizes it.

```typescript
// src/components/lists/TransactionCard.tsx
import { Pressable, Text, View } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { useTranslation } from 'react-i18next';
import type { Transaction } from '@/db/schema';

export interface TransactionCardProps {
  transaction: Transaction;
  onPress?: (id: string) => void;
  testID?: string;
}

export function TransactionCard({ transaction, onPress, testID }: TransactionCardProps) {
  const { t } = useTranslation();
  const isExpense = transaction.amount < 0;

  return (
    <Pressable
      className="mx-4 flex-row items-center rounded-lg bg-white p-4 shadow-sm active:opacity-70 dark:bg-gray-900"
      onPress={() => onPress?.(transaction.id)}
      android_ripple={{ color: 'rgba(0,0,0,0.08)' }}
      accessibilityRole="button"
      testID={testID}
    >
      <View className="mr-3 h-10 w-10 items-center justify-center rounded-full bg-primary-100">
        <Ionicons name="receipt-outline" size={20} className="text-primary-600" />
      </View>
      <View className="mr-3 flex-1">
        <Text className="text-base text-gray-900 dark:text-gray-100" numberOfLines={1}>
          {transaction.description}
        </Text>
        {transaction.category && (
          <Text className="text-xs capitalize text-gray-500">{transaction.category}</Text>
        )}
      </View>
      <Text
        className={isExpense ? 'font-semibold text-red-600' : 'font-semibold text-green-600'}
        accessibilityLabel={t(isExpense ? 'transactions.expense' : 'transactions.income')}
      >
        {transaction.amount.toFixed(2)}
      </Text>
    </Pressable>
  );
}
```

`Ionicons` takes `className` only if registered with NativeWind (`cssInterop`); otherwise
pass `color` from the theme.

