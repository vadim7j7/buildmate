## Form Input Component

React 19: `ref` is a normal prop, no `forwardRef`.

```typescript
// src/components/ui/TextInput.tsx
import type { Ref } from 'react';
import { Text, TextInput as RNTextInput, View, type TextInputProps as RNTextInputProps } from 'react-native';

export interface TextInputProps extends RNTextInputProps {
  label: string;
  error?: string;
  ref?: Ref<RNTextInput>;
}

export function TextInput({ label, error, ref, className = '', ...props }: TextInputProps) {
  return (
    <View className="gap-1">
      <Text className="text-sm font-medium text-gray-700 dark:text-gray-300">{label}</Text>
      <RNTextInput
        ref={ref}
        accessibilityLabel={label}
        className={`min-h-11 rounded-lg border bg-white px-3 text-base text-gray-900 dark:bg-gray-900 dark:text-gray-100 ${
          error ? 'border-red-500' : 'border-gray-300 dark:border-gray-700'
        } ${className}`}
        {...props}
      />
      {error && <Text className="text-xs text-red-600">{error}</Text>}
    </View>
  );
}
```

