export const Card = styled(YStack, {
  name: 'Card',
  padding: '$md',
  borderRadius: '$md',
  backgroundColor: '$background',

  variants: {
    variant: {
      default: {},
      elevated: { elevation: '$2', shadowColor: '$shadowColor' },
      outlined: { borderWidth: 1, borderColor: '$borderColor' },
