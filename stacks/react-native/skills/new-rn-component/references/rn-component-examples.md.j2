## List Item Component

A FlashList row. No `React.memo`: the React Compiler memoizes it.

```typescript
// src/components/lists/TransactionCard.tsx
import { useTranslation } from 'react-i18next';
import { Paragraph, SizableText, XStack, YStack } from 'tamagui';
import type { Transaction } from '@/db/schema';

export interface TransactionCardProps {
  transaction: Transaction;
  onPress?: (id: string) => void;
  testID?: string;
}

export function TransactionCard({ transaction, onPress, testID }: TransactionCardProps) {
  const { t } = useTranslation();
  const isExpense = transaction.amount < 0;

  return (
    <XStack
      alignItems="center"
      gap="$sm"
      marginHorizontal="$md"
      padding="$md"
      borderRadius="$md"
      backgroundColor="$background"
      pressStyle={{ backgroundColor: '$backgroundPress' }}
      onPress={() => onPress?.(transaction.id)}
      role="button"
      testID={testID}
    >
      <YStack flex={1}>
        <SizableText size="$4" numberOfLines={1}>{transaction.description}</SizableText>
        {transaction.category && (
          <Paragraph size="$2" color="$color10" textTransform="capitalize">
            {transaction.category}
          </Paragraph>
        )}
      </YStack>
      <SizableText
        size="$4"
        fontWeight="600"
        color={isExpense ? '$red10' : '$green10'}
        aria-label={t(isExpense ? 'transactions.expense' : 'transactions.income')}
      >
        {transaction.amount.toFixed(2)}
      </SizableText>
    </XStack>
  );
}
```

