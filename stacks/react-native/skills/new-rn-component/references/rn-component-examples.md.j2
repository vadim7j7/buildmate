## Card Component (UI Primitive)

Variants switch between whole class strings (Tailwind can't see `bg-${x}`).

```typescript
// src/components/ui/Card.tsx
import type { ReactNode } from 'react';
import { Pressable, View } from 'react-native';

const VARIANT_CLASSES = {
  default: 'bg-white dark:bg-gray-900',
  elevated: 'bg-white shadow-md dark:bg-gray-900',
  outlined: 'border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900',
} as const;

export interface CardProps {
  children: ReactNode;
  variant?: keyof typeof VARIANT_CLASSES;
  className?: string;
  onPress?: () => void;
  testID?: string;
}

export function Card({ children, variant = 'default', className = '', onPress, testID }: CardProps) {
  const classes = `rounded-xl p-4 ${VARIANT_CLASSES[variant]} ${className}`;

  if (onPress) {
    return (
      <Pressable className={`${classes} active:opacity-85`} onPress={onPress} testID={testID}>
        {children}
      </Pressable>
    );
  }
  return <View className={classes} testID={testID}>{children}</View>;
}
```

