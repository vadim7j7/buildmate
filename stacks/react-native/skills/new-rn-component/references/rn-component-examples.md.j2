## Form Input Component

```typescript
// src/components/forms/TextField.tsx
import {
  FormControl, FormControlLabel, FormControlLabelText,
  FormControlError, FormControlErrorText,
} from '@/components/ui/form-control';
import { Input, InputField } from '@/components/ui/input';

export interface TextFieldProps extends React.ComponentProps<typeof InputField> {
  label: string;
  error?: string;
  isRequired?: boolean;
}

// React 19: `ref` arrives in props and is passed on, no forwardRef
export function TextField({ label, error, isRequired, ...fieldProps }: TextFieldProps) {
  return (
    <FormControl isInvalid={!!error} isRequired={isRequired}>
      <FormControlLabel>
        <FormControlLabelText>{label}</FormControlLabelText>
      </FormControlLabel>
      <Input variant="outline" size="md">
        <InputField accessibilityLabel={label} {...fieldProps} />
      </Input>
      <FormControlError>
        <FormControlErrorText>{error}</FormControlErrorText>
      </FormControlError>
    </FormControl>
  );
}
```

