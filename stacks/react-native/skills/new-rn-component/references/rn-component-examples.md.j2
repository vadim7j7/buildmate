## Card Component (UI Primitive)

```typescript
// src/components/ui/AppCard.tsx -- composes the generated Card
import type { ReactNode } from 'react';
import { Card } from '@/components/ui/card';
import { Pressable } from '@/components/ui/pressable';

export interface AppCardProps {
  children: ReactNode;
  variant?: 'elevated' | 'outline' | 'filled' | 'ghost'; // the generated Card's tva variants
  onPress?: () => void;
  testID?: string;
}

export function AppCard({ children, variant = 'elevated', onPress, testID }: AppCardProps) {
  const card = (
    <Card variant={variant} size="md" className="rounded-lg" testID={testID}>
      {children}
    </Card>
  );
  if (!onPress) return card;
  return (
    <Pressable onPress={onPress} className="data-[active=true]:opacity-85">
      {card}
    </Pressable>
  );
}
```

Check the variant names in the generated `src/components/ui/card/index.tsx` and use those.

