## Screen Test Pattern (`renderRouter`)

`renderRouter` from `expo-router/testing-library` mounts screens in an in-memory
router, so links, params and redirects are real. Test files never live in `src/app/`.

```typescript
// __tests__/app/transactions.test.tsx
import { Slot } from 'expo-router';
import { renderRouter, screen } from 'expo-router/testing-library';
import { fireEvent, waitFor } from '@testing-library/react-native';
import { Providers } from '../test-utils';
import TransactionsScreen from '@/app/(tabs)/transactions';
import TransactionDetailScreen from '@/app/(tabs)/transactions/[id]';
import { getTransactions, getTransaction } from '@/db/queries/transactions';

jest.mock('@/db/queries/transactions');  // never hit the real database

const rows = [
  { id: '1', description: 'Groceries', amount: -50 },
  { id: '2', description: 'Salary', amount: 3000 },
];

function renderTransactions(initialUrl = '/transactions') {
  return renderRouter(
    {
      _layout: () => <Providers><Slot /></Providers>,
      'transactions/index': TransactionsScreen,
      'transactions/[id]': TransactionDetailScreen,
    },
    { initialUrl }
  );
}

describe('Transactions screen', () => {
  beforeEach(() => jest.clearAllMocks());

  it('lists transactions and opens one', async () => {
    jest.mocked(getTransactions).mockResolvedValue(rows);
    jest.mocked(getTransaction).mockResolvedValue(rows[0]);
    await renderTransactions();

    expect(await screen.findByText('Groceries')).toBeOnTheScreen();
    await fireEvent.press(screen.getByText('Groceries'));

    expect(screen).toHavePathname('/transactions/1');
  });

  it('shows the empty state', async () => {
    jest.mocked(getTransactions).mockResolvedValue([]);
    await renderTransactions();
    expect(await screen.findByText('transactions.empty')).toBeOnTheScreen();
  });

  it('shows the error state', async () => {
    jest.mocked(getTransactions).mockRejectedValue(new Error('Network error'));
    await renderTransactions();
    await waitFor(() => expect(screen.getByText('common.error')).toBeOnTheScreen());
  });
});
```

Other router matchers: `toHaveSegments`, `toHaveSearchParams`, `toHavePathnameWithParams`,
`toHaveRouterState`. A `_layout` key in the route map wraps every screen (providers,
`Stack.Protected` guards).

