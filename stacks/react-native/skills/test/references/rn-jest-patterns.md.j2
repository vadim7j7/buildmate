## Component Test Pattern

Assert what the user sees and does (text, roles, callbacks), not style objects:
{% if ui == 'StyleSheet' %}
style props change with every refactor.
{% else %}
{{ ui }} styles don't resolve to stable style objects in Jest.
{% endif %}

```typescript
// __tests__/components/lists/TransactionCard.test.tsx
import { fireEvent, screen } from '@testing-library/react-native';
import { renderWithProviders } from '../../test-utils';
import { TransactionCard } from '@/components/lists/TransactionCard';

const transaction = { id: '1', description: 'Grocery shopping', amount: -45.99, category: 'food' };

describe('TransactionCard', () => {
  it('renders description and amount', async () => {
    await renderWithProviders(<TransactionCard transaction={transaction} />);
    expect(screen.getByText('Grocery shopping')).toBeOnTheScreen();
    expect(screen.getByText('-$45.99')).toBeOnTheScreen();
  });

  it('calls onPress with the id', async () => {
    const onPress = jest.fn();
    await renderWithProviders(<TransactionCard transaction={transaction} onPress={onPress} />);
    await fireEvent.press(screen.getByText('Grocery shopping'));
    expect(onPress).toHaveBeenCalledWith('1');
  });

  it('labels expenses for screen readers', async () => {
    await renderWithProviders(<TransactionCard transaction={transaction} />);
    expect(screen.getByLabelText('transactions.expense')).toBeOnTheScreen();
  });
});
```

