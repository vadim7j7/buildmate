{% if lib == 'Zustand' %}
## Zustand Store Test Pattern

```typescript
// __tests__/stores/useTransactionFilterStore.test.ts
import { useTransactionFilterStore } from '@/stores/useTransactionFilterStore';

describe('useTransactionFilterStore', () => {
  // Zustand stores are module singletons: reset before EVERY test
  beforeEach(() => useTransactionFilterStore.getState().reset());

  it('starts with no filter', () => {
    expect(useTransactionFilterStore.getState().category).toBeNull();
  });

  it('sets and clears the category', () => {
    useTransactionFilterStore.getState().setCategory('food');
    expect(useTransactionFilterStore.getState().category).toBe('food');
    useTransactionFilterStore.getState().reset();
    expect(useTransactionFilterStore.getState().category).toBeNull();
  });
});
```
{% elif lib == 'Redux Toolkit' %}
## Redux Slice Test Pattern

Slices are pure reducers: test them without React.

```typescript
// __tests__/store/transactionFilterSlice.test.ts
import reducer, { setCategory, toggleSortOrder, reset } from '@/store/slices/transactionFilterSlice';

const initial = reducer(undefined, { type: '@@init' });

describe('transactionFilterSlice', () => {
  it('sets the category', () => {
    expect(reducer(initial, setCategory('food')).category).toBe('food');
  });

  it('toggles the sort order and resets', () => {
    const toggled = reducer(initial, toggleSortOrder());
    expect(toggled.sortOrder).toBe('asc');
    expect(reducer(toggled, reset())).toEqual(initial);
  });
});
```
{% elif lib == 'MobX' %}
## MobX Store Test Pattern

```typescript
// __tests__/stores/TransactionFilterStore.test.ts
import { TransactionFilterStore } from '@/stores/TransactionFilterStore';

describe('TransactionFilterStore', () => {
  let store: TransactionFilterStore;
  beforeEach(() => { store = new TransactionFilterStore(); }); // fresh instance per test

  it('sets the category', () => {
    store.setCategory('food');
    expect(store.category).toBe('food');
  });

  it('resets', () => {
    store.setCategory('food');
    store.reset();
    expect(store.category).toBeNull();
  });
});
```
{% elif lib == 'Jotai' %}
## Jotai Atom Test Pattern

```typescript
// __tests__/atoms/transactionFilter.test.ts
import { createStore } from 'jotai';
import { filterCategoryAtom, resetTransactionFilterAtom } from '@/atoms/transactionFilter';

describe('transactionFilter atoms', () => {
  let store: ReturnType<typeof createStore>;
  beforeEach(() => { store = createStore(); });  // fresh store per test

  it('sets and resets the category', () => {
    store.set(filterCategoryAtom, 'food');
    expect(store.get(filterCategoryAtom)).toBe('food');
    store.set(resetTransactionFilterAtom);
    expect(store.get(filterCategoryAtom)).toBeNull();
  });
});
```
{% else %}
## Local UI State

There is no global store. Test UI state through the component that owns it
(press the filter chip, assert the filtered list), not through internals.
{% endif %}

