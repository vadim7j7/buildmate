## Form Input Test Pattern

```typescript
// __tests__/components/forms/BudgetForm.test.tsx
import { fireEvent, screen } from '@testing-library/react-native';
import { renderWithProviders } from '../../test-utils';
import { BudgetForm } from '@/components/forms/BudgetForm';

it('validates and submits', async () => {
  const onSubmit = jest.fn();
  await renderWithProviders(<BudgetForm onSubmit={onSubmit} />);

  await fireEvent.press(screen.getByRole('button', { name: 'common.save' }));
  expect(screen.getByText('budgets.validation.nameRequired')).toBeOnTheScreen();
  expect(onSubmit).not.toHaveBeenCalled();

  await fireEvent.changeText(screen.getByTestId('budget-name-input'), 'Food');
  await fireEvent.changeText(screen.getByTestId('budget-amount-input'), '300');
  await fireEvent.press(screen.getByRole('button', { name: 'common.save' }));
  expect(onSubmit).toHaveBeenCalledWith({ name: 'Food', amount: 300 });
});
```

