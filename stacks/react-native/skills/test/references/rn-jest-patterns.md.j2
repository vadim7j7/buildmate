# React Native Jest Testing Patterns

React Native Testing Library **v14+** (required by `expo-router/testing-library`):
`render`, `renderHook`, `fireEvent` and `act` return Promises — always `await` them.
Its Jest matchers are built in (no `extend-expect` import), and query results are host
elements only. `npx codemod@latest rntl-v14-async-functions --target ./__tests__`
converts older tests.

## Setup and Configuration

### Jest Config for Expo

```javascript
// jest.config.js
module.exports = {
  preset: 'jest-expo',
  setupFilesAfterEnv: ['./jest.setup.ts'],
  transformIgnorePatterns: [
    'node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@shopify/flash-list{% if ui == 'Tamagui' %}|tamagui|@tamagui/.*{% elif ui == 'Gluestack UI' %}|@gluestack-ui/.*|nativewind|react-native-css-interop{% elif ui == 'NativeWind' %}|nativewind|react-native-css-interop{% endif %})',
  ],
  moduleNameMapper: {
    '^@/(.*)$': '<rootDir>/src/$1', // @/ -> src/ (matches tsconfig paths)
  },
  testPathIgnorePatterns: ['/node_modules/', '/.maestro/'],
  collectCoverageFrom: [
    'src/components/**/*.{ts,tsx}',
    'src/app/**/*.{ts,tsx}',
{% if lib == 'Redux Toolkit' %}
    'src/store/**/*.{ts,tsx}',
{% elif lib == 'Jotai' %}
    'src/atoms/**/*.{ts,tsx}',
{% elif lib != 'None' %}
    'src/stores/**/*.{ts,tsx}',
{% endif %}
    'src/queries/**/*.{ts,tsx}',
    'src/db/queries/**/*.{ts,tsx}',
    'src/hooks/**/*.{ts,tsx}',
    '!**/*.d.ts',
  ],
};
```

### Jest Setup File

expo-router is **not** mocked globally: screens are tested with `renderRouter`
(below), and a component test that only needs `router.push` mocks it in that file.

```typescript
// jest.setup.ts
// Predictable i18n output: t('key') -> 'key'
jest.mock('react-i18next', () => ({
  useTranslation: () => ({
    t: (key: string, params?: Record<string, unknown>) =>
      params ? `${key}:${JSON.stringify(params)}` : key,
    i18n: { changeLanguage: jest.fn(), language: 'en' },
  }),
  Trans: ({ children }: { children: React.ReactNode }) => children,
  initReactI18next: { type: '3rdParty', init: jest.fn() },
}));

jest.mock('expo-image', () => ({ Image: 'Image' }));

// SecureStore has no native module in Jest
jest.mock('expo-secure-store', () => {
  const store = new Map<string, string>();
  return {
    getItemAsync: jest.fn(async (k: string) => store.get(k) ?? null),
    setItemAsync: jest.fn(async (k: string, v: string) => void store.set(k, v)),
    deleteItemAsync: jest.fn(async (k: string) => void store.delete(k)),
  };
});
```

### Render Helper

```typescript
// __tests__/test-utils.tsx
import { useState } from 'react';
import { render } from '@testing-library/react-native';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
{% if ui == 'Tamagui' %}
import { TamaguiProvider } from 'tamagui';
import config from '../tamagui.config';
{% elif ui == 'Gluestack UI' %}
import { GluestackUIProvider } from '@/components/ui/gluestack-ui-provider';
{% endif %}
{% if lib == 'Redux Toolkit' %}
import { Provider } from 'react-redux';
import { makeStore } from '@/store';
{% elif lib == 'Jotai' %}
import { Provider, createStore } from 'jotai';
{% elif lib == 'MobX' %}
import { RootStore, StoreContext } from '@/stores/RootStore';
{% endif %}

export function createTestQueryClient() {
  // CRITICAL: a fresh client per test, no retries, no cache between tests
  return new QueryClient({
    defaultOptions: { queries: { retry: false, gcTime: 0 }, mutations: { retry: false } },
  });
}

export function Providers({ children }: { children: React.ReactNode }) {
  const [queryClient] = useState(createTestQueryClient); // one per mounted tree
  return (
    <QueryClientProvider client={queryClient}>
{% if ui == 'Tamagui' %}
      <TamaguiProvider config={config} defaultTheme="light">{children}</TamaguiProvider>
{% elif ui == 'Gluestack UI' %}
      <GluestackUIProvider mode="light">{children}</GluestackUIProvider>
{% else %}
      {children}
{% endif %}
    </QueryClientProvider>
  );
}

export async function renderWithProviders(ui: React.ReactElement) {
{% if lib == 'Redux Toolkit' %}
  const store = makeStore();                       // fresh store per test
  const result = await render(<Provider store={store}><Providers>{ui}</Providers></Provider>);
  return { store, ...result };
{% elif lib == 'Jotai' %}
  const store = createStore();                     // fresh atom store per test
  const result = await render(<Provider store={store}><Providers>{ui}</Providers></Provider>);
  return { store, ...result };
{% elif lib == 'MobX' %}
  const stores = new RootStore();                  // fresh instances per test
  const result = await render(
    <StoreContext.Provider value={stores}><Providers>{ui}</Providers></StoreContext.Provider>
  );
  return { stores, ...result };
{% else %}
  return render(ui, { wrapper: Providers });
{% endif %}
}
```

