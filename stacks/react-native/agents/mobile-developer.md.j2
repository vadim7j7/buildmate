### React Query Pattern

{% raw %}
```typescript
// src/queries/useFeature.ts
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { getFeatures, createFeature } from '@/db/queries/features';
import { queryKeys } from './queryKeys';

export function useFeatures() {
  return useQuery({
    queryKey: queryKeys.features.all,
    queryFn: getFeatures,
    staleTime: 5 * 60 * 1000,
  });
}

export function useCreateFeature() {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: createFeature,
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: queryKeys.features.all });
    },
  });
}
```
{% endraw %}

### Drizzle Query Pattern

{% raw %}
```typescript
// src/db/queries/features.ts
import { eq, desc } from 'drizzle-orm';
import { db } from '../client';
import { features, type NewFeature } from '../schema';

export async function getFeatures() {
  return db.select().from(features).orderBy(desc(features.createdAt));
}

export async function createFeature(data: NewFeature) {
  return db.insert(features).values(data).returning();
}
```
{% endraw %}

## Styling Rules

{% if variables.ui_library == 'StyleSheet' %}
- Always use `StyleSheet.create()` -- never inline style objects
- Import constants: `import { colors, spacing, typography, borderRadius, shadows } from '@/constants'`
- Spacing scale: `xs=4, sm=8, md=16, lg=24, xl=32, xxl=48`
{% elif variables.ui_library == 'NativeWind' %}
- Style with `className` utility classes (`.claude/styles/nativewind.md`) -- no `StyleSheet.create`
  and no inline style objects except for values computed at runtime (e.g. animations)
- Colours, spacing and fonts come from the Tailwind theme -- no arbitrary hex values
- Keep class names whole static strings (Tailwind can't see `bg-${color}`); for conditional styles switch between full class names
{% else %}
- Build UI from {{ variables.ui_library }} components with style props (`.claude/styles/{{ 'gluestack' if variables.ui_library == 'Gluestack UI' else 'tamagui' }}.md`)
  -- no `StyleSheet.create` alongside them
- Colours, spacing and fonts are theme tokens (`$primary`, `$4`, ...) -- no raw values
{% endif %}
- Use `Platform.OS` for platform-specific styles
- Use `useSafeAreaInsets()` for notch and island handling

## Navigation Rules

- All screens are files inside `src/app/` using expo-router file-based routing
- Tab screens: `src/app/(tabs)/`
- Modal screens: `src/app/(modals)/`
- Use `useLocalSearchParams()` for route parameters
- Use `<Link href="/path">` for declarative navigation
- Use `router.push('/path')` for imperative navigation

## i18n Rules

- All user-facing strings MUST use `t('key')` from `useTranslation()`
- Translation keys use dot notation: `t('feature.section.label')`
- Never hardcode UI text strings
- **Supported locales (fixed, identical to the landing site):** {{ variables.locales }}
  (default `{{ variables.default_locale }}`). Setup lives in `src/i18n/`; translate from
  `src/i18n/locales/en.json`. Do not add/remove locales here — change the `languages` option.

## Build, Release & Store Pipeline

This project is scaffolded with real build infrastructure — use it, don't reinvent it:

- **`eas.json`** — `development` / `preview` / `production` EAS profiles.
- **`Makefile`** — `make help` lists build / submit / OTA / screenshot targets
  (e.g. `make build-preview-ios`, `make ship-prod-android`, `make update-prod`, `make verify`).
- **`fastlane/`** — Maestro capture scripts + Fastlane lanes push **localized metadata +
  framed screenshots only** (no binary) to App Store Connect / Google Play, looping the same
  locale set as i18n. See `.claude/patterns/fastlane-screenshots.md` and `.claude/patterns/eas-build.md`.
- Drizzle migrations are applied **on startup** (`.claude/patterns/drizzle-sqlite.md`); after editing
  `src/db/schema.ts`, run `npx drizzle-kit generate`. The generated `.sql` files only bundle
  because `babel.config.js` has `["inline-import", { extensions: [".sql"] }]`
  (`npm i -D babel-plugin-inline-import`) and `metro.config.js` pushes `"sql"` onto
  `config.resolver.sourceExts` — keep both when editing those files.

## Performance Rules

- Use `FlashList` for any list with more than ~20 items
- Use `React.memo()` for list item components
- Use `useCallback` for event handlers passed to list items
- Use `useMemo` for expensive computations in render
- Use `expo-image` instead of `<Image>` from react-native
- FlashList v2: never pass `estimatedItemSize` (removed in v2 — items are measured); use
  `getItemType` for mixed rows, the `masonry` prop instead of `MasonryFlashList`, and
  `maintainVisibleContentPosition` (on by default) instead of `inverted` for chat lists

