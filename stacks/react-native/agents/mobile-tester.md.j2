### React Query Hook Test

```typescript
import { renderHook, waitFor } from '@testing-library/react-native';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { useTransactions } from '@/queries/useTransactions';
import { getTransactions } from '@/db/queries/transactions';

jest.mock('@/db/queries/transactions');

function createWrapper() {
  const queryClient = new QueryClient({
    defaultOptions: { queries: { retry: false, gcTime: 0 } },
  });
  return function Wrapper({ children }: { children: React.ReactNode }) {
    return (
      <QueryClientProvider client={queryClient}>
        {children}
      </QueryClientProvider>
    );
  };
}

describe('useTransactions', () => {
  beforeEach(() => {
    jest.clearAllMocks();
  });

  it('fetches transactions successfully', async () => {
    (getTransactions as jest.Mock).mockResolvedValue([{ id: '1' }]);

    const { result } = await renderHook(() => useTransactions(), {
      wrapper: createWrapper(),
    });

    await waitFor(() => {
      expect(result.current.isSuccess).toBe(true);
    });

    expect(result.current.data).toHaveLength(1);
  });
});
```

### i18n Catalog Parity Test

One data-driven test keeps every locale in lockstep with `en.json`. It flattens
each catalog to dot-notation key paths and asserts no keys are missing or extra
versus the source locale. This scales to all {{ variables.locale_count }} locales
without listing keys by hand, and fails loudly the moment a translation drifts.

{% raw %}
```typescript
// __tests__/i18n/catalog-parity.test.ts
import { SUPPORTED_LOCALES, DEFAULT_LOCALE } from '@/i18n';
import en from '@/i18n/locales/en.json';

// Flatten a nested catalog to a sorted set of dot-notation leaf keys.
function leafKeys(obj: Record<string, unknown>, prefix = ''): string[] {
  return Object.entries(obj).flatMap(([k, v]) => {
    const path = prefix ? `${prefix}.${k}` : k;
    return v && typeof v === 'object' && !Array.isArray(v)
      ? leafKeys(v as Record<string, unknown>, path)
      : [path];
  });
}

const sourceKeys = new Set(leafKeys(en));
// Only assert against locales whose catalog actually ships (others are added as
// translations land — see src/i18n/index.ts). en is the source of truth.
const translated = SUPPORTED_LOCALES.filter((l) => l !== DEFAULT_LOCALE);

describe.each(translated)('locale catalog parity: %s', (locale) => {
  let keys: Set<string>;
  beforeAll(() => {
    // Skip locales that haven't been translated/bundled yet.
    try {
      keys = new Set(leafKeys(require(`@/i18n/locales/${locale}.json`)));
    } catch {
      keys = new Set();
    }
  });

  it('has no missing keys vs en', () => {
    if (keys.size === 0) return; // not yet translated — nothing to check
    const missing = [...sourceKeys].filter((k) => !keys.has(k));
    expect(missing).toEqual([]);
  });

  it('has no extra keys vs en', () => {
    if (keys.size === 0) return;
    const extra = [...keys].filter((k) => !sourceKeys.has(k));
    expect(extra).toEqual([]);
  });
});
```
{% endraw %}

## E2E with Maestro

Jest can't cover real native behaviour (keyboard, permissions, deep links, the actual
navigation stack). Critical user flows get a Maestro flow in `.maestro/` (the scaffold
has `.maestro/smoke.yaml`). Run them against a development or preview build on a
simulator/emulator: `make e2e APP_ID=<bundle id>` (= `maestro test -e APP_ID=... .maestro/`).

```yaml
# .maestro/add-transaction.yaml
appId: ${APP_ID}
---
- launchApp:
    clearState: true
- tapOn:
    id: "add-transaction-button"
- inputText: "Coffee"            # types into the focused field
- tapOn:
    id: "amount-input"
- inputText: "4.50"
- tapOn:
    id: "save-button"
- assertVisible: "Coffee"
```

- Select by `testID` (`id:`) -- text changes with the locale ({{ variables.locale_count }} locales here)
- One flow per user journey; `clearState: true` so flows don't depend on each other
- Flows are not part of `npm test` (Jest ignores `.maestro/`); run them before a release
  and when a change touches navigation, auth or native modules
- `maestro studio` helps find selectors interactively

