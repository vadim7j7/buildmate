# Mobile build / ship / screenshot orchestration.
# Locales ({{ variables.locale_count }}): {{ variables.locales }}
# Generated by buildmate — safe to edit.

export EAS_BUILD_NO_EXPO_GO_WARNING := true
export FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT := 180
export FASTLANE_XCODEBUILD_SETTINGS_RETRIES := 5

.PHONY: help install start verify lint typecheck test \
        device-ios device-android \
        build-dev build-preview-ios build-preview-android build-prod-ios build-prod-android \
        submit-prod-ios submit-prod-android ship-prod-ios ship-prod-android \
        update-preview update-prod \
        screenshots-ios screenshots-android frame-ios frame-android \
        stage-ios stage-android upload-ios upload-android upload-ios-dry upload-android-dry \
        clean

help:
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-22s\033[0m %s\n", $$1, $$2}'

install: ## Install JS deps + native modules
	npm install && npx expo install --fix

start: ## Start the Metro dev server
	npx expo start

# ---- Quality gate (CI) ----
verify: lint typecheck test ## Lint + typecheck + test
lint: ; npm run lint
typecheck: ; npx tsc --noEmit
test: ; npm test

# ---- Local device builds ----
device-ios: ## Build + install on a tethered iPhone
	npx expo run:ios --device
device-android: ## Build + install on a tethered Android device
	npx expo run:android --device

# ---- EAS cloud builds ----
build-dev: ; eas build --profile development --platform all
build-preview-ios: ; eas build --profile preview --platform ios
build-preview-android: ; eas build --profile preview --platform android
build-prod-ios: ; eas build --profile production --platform ios
build-prod-android: ; eas build --profile production --platform android

# ---- Store submission ----
submit-prod-ios: ; eas submit --profile production --platform ios
submit-prod-android: ; eas submit --profile production --platform android
ship-prod-ios: build-prod-ios submit-prod-ios ## Build + submit iOS
ship-prod-android: build-prod-android submit-prod-android ## Build + submit Android

# ---- OTA updates ----
update-preview: ; eas update --branch preview --message "$(MESSAGE)"
update-prod: ; eas update --branch production --message "$(MESSAGE)"

# ---- Store screenshots (Maestro capture -> Fastlane frame -> upload) ----
screenshots-ios: ; ./fastlane/capture-screenshots-ios.sh
screenshots-android: ; ./fastlane/capture-screenshots.sh
frame-ios: ; cd fastlane && fastlane ios caption_screenshots
frame-android: ; cd fastlane && fastlane android caption_screenshots
stage-ios: ; cd fastlane && fastlane ios stage_screenshots
stage-android: ; cd fastlane && fastlane android stage_screenshots
upload-ios-dry: ; cd fastlane && fastlane ios upload_metadata verify_only:true
upload-android-dry: ; cd fastlane && fastlane android upload_metadata validate_only:true
upload-ios: ; cd fastlane && fastlane ios upload_metadata
upload-android: ; cd fastlane && fastlane android upload_metadata

clean: ## Remove caches and native build output
	rm -rf node_modules ios/build android/app/build "$$HOME/Library/Developer/Xcode/DerivedData"
