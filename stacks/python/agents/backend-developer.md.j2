## Code Patterns

### Schema Pattern (Pydantic v2)

```python
from datetime import datetime

from pydantic import BaseModel, ConfigDict


class ResourceBase(BaseModel):
    """Shared fields for resource schemas."""

    name: str
    description: str | None = None


class ResourceCreate(ResourceBase):
    """Schema for creating a resource."""


class ResourceUpdate(BaseModel):
    """Schema for updating a resource (all fields optional)."""

    name: str | None = None
    description: str | None = None


class ResourceRead(ResourceBase):
    """Schema for reading a resource (includes DB fields)."""

    model_config = ConfigDict(from_attributes=True)

{% if not nodb %}
    id: {% if mongo %}str{% else %}int{% endif %}
    created_at: datetime
    updated_at: datetime
{% endif %}
```

{% if nodb %}
### Service Pattern (no database)

```python
from dataclasses import dataclass

from app.schemas.resource import ResourceCreate


@dataclass(frozen=True, slots=True)
class Resource:
    """Domain value object."""

    name: str
    description: str | None = None


class ResourceService:
    """Business logic; I/O dependencies (HTTP client, file store) are injected."""

    def build(self, payload: ResourceCreate) -> Resource:
        """Create a resource from validated input."""
        return Resource(**payload.model_dump())
```

Use `async def` only where the code does async I/O; a CLI entry point calls
`asyncio.run(main())` once.
{% elif mongo %}
### Document Model Pattern (Pydantic v2 + PyMongo)

```python
from datetime import UTC, datetime

from pydantic import BaseModel, ConfigDict, Field

from app.db.types import PyObjectId  # Annotated ObjectId type, see mongodb.md


def utc_now() -> datetime:
    return datetime.now(UTC)


class Resource(BaseModel):
    """Document stored in the resources collection."""

    model_config = ConfigDict(populate_by_name=True)

    id: PyObjectId | None = Field(default=None, alias="_id")
    name: str
    description: str | None = None
    created_at: datetime = Field(default_factory=utc_now)
    updated_at: datetime = Field(default_factory=utc_now)
```

### Service Pattern

```python
from bson import ObjectId
from pymongo.asynchronous.database import AsyncDatabase

from app.models.resource import Resource
from app.schemas.resource import ResourceCreate


class ResourceService:
    """Business logic for resource operations."""

    def __init__(self, db: AsyncDatabase) -> None:
        self._collection = db.resources

    async def list(self, *, skip: int = 0, limit: int = 20) -> list[Resource]:
        """List resources with pagination."""
        cursor = self._collection.find().skip(skip).limit(limit)
        return [Resource.model_validate(doc) async for doc in cursor]

    async def get_by_id(self, resource_id: str) -> Resource | None:
        """Get a resource by its ObjectId."""
        doc = await self._collection.find_one({"_id": ObjectId(resource_id)})
        return Resource.model_validate(doc) if doc else None

    async def create(self, payload: ResourceCreate) -> Resource:
        """Create a new resource."""
        resource = Resource(**payload.model_dump())
        data = resource.model_dump(by_alias=True, exclude={"id"})
        result = await self._collection.insert_one(data)
        resource.id = str(result.inserted_id)
        return resource
```
