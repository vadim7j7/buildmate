## Fiber Version

This stack targets **Fiber v3** (`github.com/gofiber/fiber/v3`; v3.6+ needs Go 1.26).
If `go.mod` still requires `github.com/gofiber/fiber/v2`, keep writing v2 code in that
project (`*fiber.Ctx`, `c.BodyParser`, `c.UserContext()`) and do not mix majors.

Key v3 differences from v2:

| v2 | v3 |
|----|----|
| `func(c *fiber.Ctx) error` | `func(c fiber.Ctx) error` (`fiber.Ctx` is an interface) |
| `c.BodyParser(&in)` | `c.Bind().Body(&in)` (runs `Config.StructValidator` if set) |
| `c.UserContext()` | pass `c` itself: `fiber.Ctx` implements `context.Context` |
| `c.Locals("k")` type assertions | `fiber.Locals[T](c, "k")` |
| `c.ParamsInt("id")` | `fiber.Params[int](c, "id")` |
| `app.Listen(":8080")` | `app.Listen(":8080", fiber.ListenConfig{...})` |

**Zero-copy rule (v2 and v3):** strings returned by `c.Params()`, `c.Query()`,
`c.Get()`, `c.Body()` etc. point into a buffer Fiber reuses after the handler returns.
They are only valid inside the handler. Before storing one (struct field, map, cache,
channel, goroutine), copy it with `strings.Clone(v)` (or `utils.CopyString`), or set
`fiber.Config{Immutable: true}` app-wide.

## Project Layout

```
cmd/server/main.go        # entry point: config, wiring, /health, graceful shutdown
internal/router/          # SetupRoutes
internal/handler/         # HTTP handlers
internal/middleware/      # app middleware
internal/service/         # business logic
internal/repository/      # data access
```

The dev server is started with `PORT=8080 go run ./cmd/server` and checked with
`GET /health`, so `cmd/server/main.go` must exist, read `PORT` (default `8080`),
and serve `GET /health` returning `200` with a JSON body.

## Code Patterns

### Server Entry Point (`cmd/server/main.go`)

```go
package main

import (
	"context"
	"log/slog"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/go-playground/validator/v10"
	"github.com/gofiber/fiber/v3"
	"github.com/gofiber/fiber/v3/middleware/logger"
	recoverer "github.com/gofiber/fiber/v3/middleware/recover"
	"github.com/gofiber/fiber/v3/middleware/requestid"
)

type structValidator struct{ v *validator.Validate }

func (s structValidator) Validate(out any) error { return s.v.Struct(out) }

func main() {
	if err := run(); err != nil {
		slog.Error("server stopped", "err", err)
		os.Exit(1)
	}
}

func run() error {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}

	app := fiber.New(fiber.Config{
		ErrorHandler:    handler.ErrorHandler,
		StructValidator: structValidator{v: validator.New()},
		ReadTimeout:     5 * time.Second,
		WriteTimeout:    10 * time.Second,
		StrictRouting:   true,
		CaseSensitive:   true,
	})

	app.Use(requestid.New(), logger.New(), recoverer.New())

	app.Get("/health", func(c fiber.Ctx) error {
		return c.JSON(fiber.Map{"status": "ok"})
	})

	router.SetupRoutes(app, h, mw) // h, mw built from config/services above

	errCh := make(chan error, 1)
	go func() {
		errCh <- app.Listen(":"+port, fiber.ListenConfig{DisableStartupMessage: true})
	}()

	select {
	case err := <-errCh:
		return err
	case <-ctx.Done():
	}

	shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	return app.ShutdownWithContext(shutdownCtx)
}
```

### Route Group Pattern

```go
package router

import "github.com/gofiber/fiber/v3"

func SetupRoutes(app *fiber.App, h *handler.Handler, mw *middleware.Middleware) {
	api := app.Group("/api/v1")

	// Public routes
	auth := api.Group("/auth")
	auth.Post("/login", h.Auth.Login)
	auth.Post("/register", h.Auth.Register)

	// Protected routes
	users := api.Group("/users", mw.Auth())
	users.Get("/", h.User.List)
	users.Get("/:id", h.User.Get)
	users.Post("/", h.User.Create)
	users.Put("/:id", h.User.Update)
	users.Delete("/:id", h.User.Delete)
}
```

### Middleware Pattern

```go
package middleware

import "github.com/gofiber/fiber/v3"

// Auth returns JWT authentication middleware.
func (m *Middleware) Auth() fiber.Handler {
	return func(c fiber.Ctx) error {
		token := c.Get("Authorization")
		if token == "" {
			return c.Status(fiber.StatusUnauthorized).JSON(fiber.Map{
				"error": "missing authorization header",
			})
		}

		claims, err := m.tokenService.Validate(token)
		if err != nil {
			return c.Status(fiber.StatusUnauthorized).JSON(fiber.Map{
				"error": "invalid token",
			})
		}

		fiber.Locals[string](c, "user_id", claims.UserID)
		return c.Next()
	}
}
```

### Handler Pattern

```go
package handler

import (
	"strings"

	"github.com/gofiber/fiber/v3"
)

// UserHandler handles user-related HTTP requests.
type UserHandler struct {
	svc service.UserService
}

// NewUserHandler creates a new UserHandler.
func NewUserHandler(svc service.UserService) *UserHandler {
	return &UserHandler{svc: svc}
}

// CreateUserRequest is validated by Config.StructValidator during Bind().
type CreateUserRequest struct {
	Name  string `json:"name" validate:"required,min=1,max=100"`
	Email string `json:"email" validate:"required,email"`
}

// Create handles POST /users.
func (h *UserHandler) Create(c fiber.Ctx) error {
	var input CreateUserRequest
	if err := c.Bind().Body(&input); err != nil {
		return respondBindError(c, err)
	}

	// fiber.Ctx is a context.Context: pass c to the service layer.
	user, err := h.svc.CreateUser(c, input.ToServiceInput())
	if err != nil {
		return handleError(c, err)
	}

	return c.Status(fiber.StatusCreated).JSON(toUserResponse(user))
}

// Get handles GET /users/:id.
func (h *UserHandler) Get(c fiber.Ctx) error {
	// Copy: c.Params is only valid until the handler returns, and the
	// service may cache or log it asynchronously.
	id := strings.Clone(c.Params("id"))

	user, err := h.svc.GetUser(c, id)
	if err != nil {
		return handleError(c, err)
	}

	return c.JSON(toUserResponse(user))
}
```

### Error Handling

Clients get a fixed message and a stable `code`, never `err.Error()` (wrapped
errors carry SQL, IDs and parser text). Validation failures may list fields.

```go
package handler

import (
	"errors"
	"log/slog"

	"github.com/go-playground/validator/v10"
	"github.com/gofiber/fiber/v3"
)

// FieldError is one failed validation rule; safe to return to clients.
type FieldError struct {
	Field string `json:"field"`
	Rule  string `json:"rule"`
}

// respondBindError maps a Bind() error to 400 without echoing parser text.
func respondBindError(c fiber.Ctx, err error) error {
	var verrs validator.ValidationErrors
	if errors.As(err, &verrs) {
		fields := make([]FieldError, 0, len(verrs))
		for _, fe := range verrs {
			fields = append(fields, FieldError{Field: fe.Field(), Rule: fe.Tag()})
		}
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{
			"error": "validation failed", "code": "VALIDATION_FAILED", "fields": fields,
		})
	}
	return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{
		"error": "invalid request body", "code": "INVALID_BODY",
	})
}

func handleError(c fiber.Ctx, err error) error {
	switch {
	case errors.Is(err, apperror.ErrNotFound):
		return c.Status(fiber.StatusNotFound).JSON(fiber.Map{"error": "resource not found", "code": "NOT_FOUND"})
	case errors.Is(err, apperror.ErrValidation):
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "validation failed", "code": "VALIDATION_FAILED"})
	case errors.Is(err, apperror.ErrUnauthorized):
		return c.Status(fiber.StatusUnauthorized).JSON(fiber.Map{"error": "unauthorized", "code": "UNAUTHORIZED"})
	default:
		return ErrorHandler(c, err)
	}
}

// ErrorHandler is the app-wide fiber.Config.ErrorHandler.
func ErrorHandler(c fiber.Ctx, err error) error {
	// fiber.Error messages are Fiber's own ("Not Found", "Method Not Allowed").
	var e *fiber.Error
	if errors.As(err, &e) {
		return c.Status(e.Code).JSON(fiber.Map{"error": e.Message})
	}
	slog.ErrorContext(c, "unhandled error", "err", err)
	return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{
		"error": "internal server error", "code": "INTERNAL",
	})
}
```

