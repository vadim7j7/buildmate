### Browser-Based Scraper ({{ variables.browser_tool }})

Use the browser only for pages whose data is not in the HTML or a JSON API
(`.claude/patterns/api-discovery.md`); plain HTTP is faster and harder to detect.

{% if variables.language == 'Python' and variables.browser_tool == 'Puppeteer' %}
> **Puppeteer has no maintained Python library** (pyppeteer is abandoned). Use
> Playwright for Python, which has the same model (browser, context, page) and also
> drives Chromium. Re-run the setup with `--browser=playwright` to make it the
> project's documented tool. The example below is Playwright;
> `.claude/patterns/puppeteer.md` shows the Node.js API and does not apply here.

{% endif %}
{% if variables.language == 'Python' and variables.browser_tool in ['Playwright', 'Puppeteer'] %}
```python
from playwright.async_api import async_playwright


class DynamicScraper:
    async def scrape_with_browser(self, url: str) -> list[dict[str, str | None]]:
        async with async_playwright() as p:
            browser = await p.chromium.launch(headless=True)
            try:
                context = await browser.new_context(
                    user_agent=self._get_user_agent(),
                    viewport={"width": 1920, "height": 1080},
                )
                page = await context.new_page()

                # Block unnecessary resources
                await page.route(
                    "**/*.{png,jpg,jpeg,gif,svg,ico,woff,woff2}",
                    lambda route: route.abort(),
                )

                await page.goto(url, wait_until="domcontentloaded")
                # Wait for the element you need, not for "networkidle"
                await page.wait_for_selector(".product-list", timeout=10_000)

                return await page.eval_on_selector_all(
                    ".product",
                    """els => els.map(p => ({
                        name: p.querySelector('.name')?.textContent?.trim() ?? null,
                        price: p.querySelector('.price')?.textContent?.trim() ?? null,
                    }))""",
                )
            finally:
                await browser.close()
```
{% elif variables.language == 'Python' and variables.browser_tool == 'Selenium' %}
```python
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support import expected_conditions as EC
from selenium.webdriver.support.ui import WebDriverWait


def scrape_with_browser(url: str, user_agent: str) -> list[dict[str, str]]:
    """Selenium is synchronous: call it via asyncio.to_thread() from async code."""
    options = webdriver.ChromeOptions()
    options.add_argument("--headless=new")
    options.add_argument("--window-size=1920,1080")
    options.add_argument(f"--user-agent={user_agent}")
    # Selenium Manager (Selenium 4.6+) downloads a matching chromedriver
    driver = webdriver.Chrome(options=options)
    try:
        driver.get(url)
        # Explicit waits, never time.sleep()
        WebDriverWait(driver, 10).until(
            EC.presence_of_element_located((By.CSS_SELECTOR, ".product-list"))
        )
        return [
            {
                "name": item.find_element(By.CSS_SELECTOR, ".name").text.strip(),
                "price": item.find_element(By.CSS_SELECTOR, ".price").text.strip(),
            }
            for item in driver.find_elements(By.CSS_SELECTOR, ".product")
        ]
    finally:
        driver.quit()
```
{% elif variables.browser_tool == 'Playwright' %}
```typescript
import { chromium } from 'playwright';

export async function scrapeWithBrowser(url: string, userAgent: string) {
  const browser = await chromium.launch({ headless: true });
  try {
    const context = await browser.newContext({
      userAgent,
      viewport: { width: 1920, height: 1080 },
    });
    const page = await context.newPage();

    // Block unnecessary resources
    await page.route('**/*.{png,jpg,jpeg,gif,svg,ico,woff,woff2}', (route) =>
      route.abort()
    );

    await page.goto(url, { waitUntil: 'domcontentloaded' });
    // Wait for the element you need, not for "networkidle"
    await page.waitForSelector('.product-list', { timeout: 10_000 });

    return await page.$$eval('.product', (els) =>
      els.map((p) => ({
        name: p.querySelector('.name')?.textContent?.trim() ?? null,
        price: p.querySelector('.price')?.textContent?.trim() ?? null,
      }))
    );
  } finally {
    await browser.close();
  }
}
```
{% elif variables.browser_tool == 'Puppeteer' %}
```typescript
import puppeteer from 'puppeteer';

export async function scrapeWithBrowser(url: string, userAgent: string) {
  const browser = await puppeteer.launch({ headless: true });
  try {
    const page = await browser.newPage();
    await page.setUserAgent(userAgent);
    await page.setViewport({ width: 1920, height: 1080 });

    // Block unnecessary resources
    await page.setRequestInterception(true);
    page.on('request', (request) => {
      if (['image', 'font', 'media'].includes(request.resourceType())) {
        void request.abort();
      } else {
        void request.continue();
      }
    });

    await page.goto(url, { waitUntil: 'domcontentloaded' });
    // Wait for the element you need, not for network idle
    await page.waitForSelector('.product-list', { timeout: 10_000 });

    return await page.$$eval('.product', (els) =>
      els.map((p) => ({
        name: p.querySelector('.name')?.textContent?.trim() ?? null,
        price: p.querySelector('.price')?.textContent?.trim() ?? null,
      }))
    );
  } finally {
    await browser.close();
  }
}
```
See `.claude/patterns/puppeteer.md` for waiting, forms, pagination and interception.
{% elif variables.browser_tool == 'Selenium' %}
```typescript
import { Builder, By, until } from 'selenium-webdriver';
import * as chrome from 'selenium-webdriver/chrome';

export async function scrapeWithBrowser(url: string, userAgent: string) {
  const options = new chrome.Options().addArguments(
    '--headless=new',
    '--window-size=1920,1080',
    `--user-agent=${userAgent}`
  );
  // Selenium Manager downloads a matching chromedriver
  const driver = await new Builder()
    .forBrowser('chrome')
    .setChromeOptions(options)
    .build();
  try {
    await driver.get(url);
    // Explicit waits, never fixed sleeps
    await driver.wait(until.elementLocated(By.css('.product-list')), 10_000);

    const items = await driver.findElements(By.css('.product'));
    return await Promise.all(
      items.map(async (item) => ({
        name: (await item.findElement(By.css('.name')).getText()).trim(),
        price: (await item.findElement(By.css('.price')).getText()).trim(),
      }))
    );
  } finally {
    await driver.quit();
  }
}
```
