### Pages That Render With JavaScript (HTTP-only project)

This project is set up without a browser (`--browser=none`). Before reaching for one:

1. Find the JSON API the page calls (browser DevTools, Network tab) and request it
   directly with {{ variables.http_client }}; see `.claude/patterns/api-discovery.md`.
2. Look for data embedded in the HTML: `<script type="application/ld+json">`,
   `__NEXT_DATA__`, `window.__INITIAL_STATE__`.
3. Only if neither works, ask before adding a browser dependency.

{% if variables.language == 'Python' %}
```python
import json

from bs4 import BeautifulSoup


def extract_next_data(html: str) -> dict:
    """Read the JSON a Next.js page embeds instead of rendering it in a browser."""
    soup = BeautifulSoup(html, "lxml")
    script = soup.select_one("script#__NEXT_DATA__")
    if script is None or not script.string:
        raise ValueError("No __NEXT_DATA__ on this page")
    return json.loads(script.string)
```
{% else %}
```typescript
import * as cheerio from 'cheerio';

// Read the JSON a Next.js page embeds instead of rendering it in a browser
export function extractNextData(html: string): unknown {
  const $ = cheerio.load(html);
  const raw = $('script#__NEXT_DATA__').text();
  if (!raw) throw new Error('No __NEXT_DATA__ on this page');
  return JSON.parse(raw);
}
```
{% endif %}
