### Data Fetching Layer

Server-side data functions in `src/lib/data/`. These run on the server only.

```typescript
// src/lib/data/projects.ts
import 'server-only';
import { cache } from 'react';
import { db } from '@/lib/db';
import { requireUser } from '@/lib/auth';

export const getProjects = cache(async () => {
  const user = await requireUser();
  return db.project.findMany({
    where: { ownerId: user.id },
    orderBy: { updatedAt: 'desc' },
  });
});

export const getProject = cache(async (id: string) => {
  const user = await requireUser();
  return db.project.findFirst({
    where: { id, ownerId: user.id },
  });
});
```

If the app talks to an external backend API instead of a database, these functions
call the server-only services in `src/services/` (see `/new-api-service`).

### Server Action Pattern

Use Server Actions for mutations. NO API routes for CRUD operations.

**Every Server Action is a public POST endpoint** — anyone can call it with any
arguments. Inside **every** action:

1. **Authenticate**: get the session, reject if signed out.
2. **Authorize**: check the user may touch this resource (scope queries by owner/tenant/role).
3. **Validate**: parse all input (FormData, IDs) with Zod.

Checks in the page, the UI, or `proxy.ts` do not protect the action.

```typescript
// src/lib/actions/projects.ts
'use server';

import { z } from 'zod';
import { revalidatePath } from 'next/cache';
import { redirect } from 'next/navigation';
import { db } from '@/lib/db';
import { requireUser } from '@/lib/auth'; // returns the session user or throws/redirects

const ProjectSchema = z.object({
  name: z.string().trim().min(2).max(100),
  description: z.string().trim().max(1000).default(''),
});

export type ProjectFormState =
  | { status: 'idle' }
  | { status: 'error'; error: string; fieldErrors?: Record<string, string[] | undefined> };

// Form action: (prevState, formData) — the signature useActionState calls.
export async function createProject(
  _prevState: ProjectFormState,
  formData: FormData
): Promise<ProjectFormState> {
  const user = await requireUser();                                   // 1. authenticate

  const parsed = ProjectSchema.safeParse({                            // 3. validate
    name: formData.get('name'),
    description: formData.get('description') ?? undefined,
  });
  if (!parsed.success) {
    return {
      status: 'error',
      error: 'Validation failed',
      fieldErrors: z.flattenError(parsed.error).fieldErrors,
    };
  }

  await db.project.create({ data: { ...parsed.data, ownerId: user.id } });

{% if variables.i18n %}
  revalidatePath('/[locale]/projects', 'page');
{% else %}
  revalidatePath('/projects');
{% endif %}
  redirect('/projects'); // outside try/catch: redirect() throws to navigate
}

export async function deleteProject(projectId: string): Promise<void> {
  const user = await requireUser();                                   // 1. authenticate
  const id = z.string().uuid().parse(projectId);                      // 3. validate

  const { count } = await db.project.deleteMany({
    where: { id, ownerId: user.id },                                  // 2. authorize
  });
  if (count === 0) throw new Error('Not found');

{% if variables.i18n %}
  revalidatePath('/[locale]/projects', 'page');
{% else %}
  revalidatePath('/projects');
{% endif %}
}
```

### Client Component (Only When Needed)

Only use `'use client'` for interactivity. Keep them small and focused; they get data
as props and call Server Actions.

```typescript
// src/components/projects/DeleteProjectButton.tsx
'use client';

import { useTransition } from 'react';
{% if variables.i18n %}
import { useTranslations } from 'next-intl';
{% endif %}
import { deleteProject } from '@/lib/actions/projects';

export function DeleteProjectButton({ projectId }: { projectId: string }) {
{% if variables.i18n %}
  const t = useTranslations('projects');
{% endif %}
  const [isPending, startTransition] = useTransition();

  const handleDelete = () => {
    startTransition(() => deleteProject(projectId));
  };

  return (
    <button onClick={handleDelete} disabled={isPending}>
{% if variables.i18n %}
      {isPending ? t('deleting') : t('delete')}
{% else %}
      {isPending ? 'Deleting...' : 'Delete'}
{% endif %}
    </button>
  );
}
```

### Form with Server Action

Forms use the native `action` attribute with `useActionState`. The action's
signature is `(prevState: State, formData: FormData)`.

```typescript
// src/components/projects/CreateProjectForm.tsx
'use client';

import { useActionState } from 'react';
{% if variables.i18n %}
import { useTranslations } from 'next-intl';
{% endif %}
import { createProject, type ProjectFormState } from '@/lib/actions/projects';

const initialState: ProjectFormState = { status: 'idle' };

export function CreateProjectForm() {
{% if variables.i18n %}
  const t = useTranslations('projects.form');
{% endif %}
  const [state, formAction, isPending] = useActionState(createProject, initialState);

  return (
    <form action={formAction}>
{% if variables.i18n %}
      <label htmlFor="name">{t('name')}</label>
{% else %}
      <label htmlFor="name">Name</label>
{% endif %}
      <input id="name" name="name" required />
      {state.status === 'error' && state.fieldErrors?.name && (
        <p role="alert">{state.fieldErrors.name[0]}</p>
      )}
{% if variables.i18n %}
      <label htmlFor="description">{t('description')}</label>
{% else %}
      <label htmlFor="description">Description</label>
{% endif %}
      <input id="description" name="description" />
      <button type="submit" disabled={isPending}>
{% if variables.i18n %}
        {isPending ? t('submitting') : t('submit')}
{% else %}
        {isPending ? 'Creating...' : 'Create'}
{% endif %}
      </button>
    </form>
  );
}
```

## Style Rules (MANDATORY)

1. **Server Components by default** - No `'use client'` unless needed
2. **Data in `src/lib/data/`** - Server-only data functions with `cache()`, awaited by pages
3. **Mutations in `src/lib/actions/`** - Server Actions with `'use server'`
4. **Auth + authz + Zod in every Server Action** - Actions are public endpoints
5. **`revalidatePath()` after mutations** - Refresh cached data
6. **`params` / `searchParams` are Promises** - Type as `Promise<...>` and `await`
{% if variables.i18n %}
7. **Pages under `src/app/[locale]/`; copy via `getTranslations` / `useTranslations`** - No hardcoded user-facing strings; new keys in every `src/messages/*.json`
{% endif %}
8. **`type` for props** - Not `interface`
9. **No `any` types** - Use `unknown` with type guards
10. **Named exports** - Except pages (default export required by Next.js)
11. **{{ variables.ui_library }} components** - Use {{ variables.ui_library }} components where appropriate
12. **`@/` imports** - Absolute imports for internal modules

## When to Use 'use client'

| Needs... | 'use client'? |
|---|---|
| Fetching data in page | **No** - use async Server Component |
| Displaying props | **No** - Server Component |
| `onClick`, `onChange` | **Yes** |
| `useState`, `useEffect` | **Yes** |
| `useActionState`, `useTransition` | **Yes** |
| `useRouter()`, `useSearchParams()` | **Yes** |

