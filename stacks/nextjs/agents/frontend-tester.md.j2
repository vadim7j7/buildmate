## Test Patterns

### Component Test

```typescript
// src/components/ProjectCard.test.tsx
import { render, screen } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { ProjectCard } from './ProjectCard';

const mockProject = {
  id: '1',
  name: 'Test Project',
  description: 'A test project',
};

describe('ProjectCard', () => {
  it('renders project name and description', () => {
    render(<ProjectCard project={mockProject} />);

    expect(screen.getByText('Test Project')).toBeInTheDocument();
    expect(screen.getByText('A test project')).toBeInTheDocument();
  });

  it('calls onDelete when delete button is clicked', async () => {
    const user = userEvent.setup();
    const onDelete = jest.fn();
    render(<ProjectCard project={mockProject} onDelete={onDelete} />);

    await user.click(screen.getByRole('button', { name: /delete/i }));

    expect(onDelete).toHaveBeenCalledWith('1');
  });

  it('does not render delete button when onDelete is not provided', () => {
    render(<ProjectCard project={mockProject} />);

    expect(screen.queryByRole('button', { name: /delete/i })).not.toBeInTheDocument();
  });
});
```

The app is server-first: pages are async Server Components that fetch on the
server, client components ("containers") receive data as props, and mutations are
Server Actions. Test each layer where it lives:

| Layer | How to test |
|---|---|
| Data functions (`src/lib/data/`) | Unit test the function; mock the DB/service and `server-only` |
| Server Actions (`src/lib/actions/`) | Unit test: signed-out rejected, other user's resource rejected, invalid input returns field errors, happy path mutates + revalidates |
| Client islands | Render with props, mock the Server Action, assert it is called |
| Async Server Component pages | Playwright E2E (RTL cannot render async Server Components reliably) |

{% if api.bff %}
This app is a BFF for the {{ api.api_name }} backend: there is no `@/lib/db`. In data function
and Server Action tests, mock the service module (`jest.mock('@/services/projects')`)
where the examples below mock `@/lib/db`, and assert the service was called with the
validated input. Ownership is enforced by the backend, so test that an `ApiError(403/404)`
from the service surfaces as the action's error state.

{% endif %}
### Client Island (Container) Test

```typescript
// src/components/projects/DeleteProjectButton.test.tsx
import { render, screen, waitFor } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
{% if variables.i18n %}
import { NextIntlClientProvider } from 'next-intl';
import messages from '@/messages/{{ variables.default_locale }}.json';
{% endif %}
import { DeleteProjectButton } from './DeleteProjectButton';
import { deleteProject } from '@/lib/actions/projects';

jest.mock('@/lib/actions/projects', () => ({
  deleteProject: jest.fn().mockResolvedValue(undefined),
}));

{% if variables.i18n %}
const renderWithIntl = (ui: React.ReactElement) =>
  render(
    <NextIntlClientProvider locale="{{ variables.default_locale }}" messages={messages}>
      {ui}
    </NextIntlClientProvider>
  );

{% endif %}
describe('DeleteProjectButton', () => {
  beforeEach(() => {
    jest.clearAllMocks();
  });

  it('calls the deleteProject Server Action with the id it was given', async () => {
    const user = userEvent.setup();
{% if variables.i18n %}
    renderWithIntl(<DeleteProjectButton projectId="p1" />);
{% else %}
    render(<DeleteProjectButton projectId="p1" />);
{% endif %}

    await user.click(screen.getByRole('button', { name: /delete/i }));

    await waitFor(() => {
      expect(deleteProject).toHaveBeenCalledWith('p1');
    });
  });
});
```

### Server Action Test

```typescript
// src/lib/actions/projects.test.ts
import { deleteProject } from './projects';
import { requireUser } from '@/lib/auth';
import { db } from '@/lib/db';
import { revalidatePath } from 'next/cache';

jest.mock('@/lib/auth', () => ({ requireUser: jest.fn() }));
jest.mock('@/lib/db', () => ({ db: { project: { deleteMany: jest.fn() } } }));
jest.mock('next/cache', () => ({ revalidatePath: jest.fn() }));

const VALID_ID = '3f2b8c1e-8a3b-4c7d-9e2f-1a2b3c4d5e6f';

describe('deleteProject', () => {
  beforeEach(() => {
    jest.clearAllMocks();
  });

  it('rejects a signed-out caller', async () => {
    (requireUser as jest.Mock).mockRejectedValue(new Error('Unauthorized'));

    await expect(deleteProject(VALID_ID)).rejects.toThrow('Unauthorized');
    expect(db.project.deleteMany).not.toHaveBeenCalled();
  });

  it('rejects an invalid id', async () => {
    (requireUser as jest.Mock).mockResolvedValue({ id: 'u1' });

    await expect(deleteProject('not-a-uuid')).rejects.toThrow();
    expect(db.project.deleteMany).not.toHaveBeenCalled();
  });

  it("cannot delete another user's project", async () => {
    (requireUser as jest.Mock).mockResolvedValue({ id: 'u1' });
    (db.project.deleteMany as jest.Mock).mockResolvedValue({ count: 0 });

    await expect(deleteProject(VALID_ID)).rejects.toThrow('Not found');
    expect(db.project.deleteMany).toHaveBeenCalledWith({
      where: { id: VALID_ID, ownerId: 'u1' },
    });
    expect(revalidatePath).not.toHaveBeenCalled();
  });

  it('deletes the owned project and revalidates', async () => {
    (requireUser as jest.Mock).mockResolvedValue({ id: 'u1' });
    (db.project.deleteMany as jest.Mock).mockResolvedValue({ count: 1 });

    await deleteProject(VALID_ID);

    expect(revalidatePath).toHaveBeenCalled();
  });
});
```

### Data Function Test

```typescript
// src/lib/data/projects.test.ts
jest.mock('server-only', () => ({}));
jest.mock('@/lib/auth', () => ({ requireUser: jest.fn().mockResolvedValue({ id: 'u1' }) }));
jest.mock('@/lib/db', () => ({ db: { project: { findMany: jest.fn() } } }));

import { db } from '@/lib/db';
import { getProjects } from './projects';

describe('getProjects', () => {
  it("returns only the current user's projects", async () => {
    (db.project.findMany as jest.Mock).mockResolvedValue([{ id: '1' }]);

    await expect(getProjects()).resolves.toHaveLength(1);
    expect(db.project.findMany).toHaveBeenCalledWith(
      expect.objectContaining({ where: { ownerId: 'u1' } })
    );
  });
});
```

### E2E Test (Playwright)

```typescript
// e2e/projects.spec.ts
import { test, expect } from '@playwright/test';

test.describe('Projects', () => {
  test('can create a new project', async ({ page }) => {
    await page.goto('/projects');

    await page.getByRole('button', { name: 'New Project' }).click();
    await page.getByLabel('Name').fill('My New Project');
    await page.getByLabel('Description').fill('A test project');
    await page.getByRole('button', { name: 'Create' }).click();

    await expect(page.getByRole('heading', { name: 'My New Project' })).toBeVisible();
  });

  test('can delete a project', async ({ page }) => {
    await page.goto('/projects');

    await page.getByRole('button', { name: 'Delete' }).first().click();
    await page.getByRole('dialog').getByRole('button', { name: 'Confirm' }).click();

    await expect(page.getByRole('status')).toHaveText(/Project deleted/);
  });
});
```

## Test Style Rules

1. **Describe/it blocks** - Use descriptive names
2. **Mock external dependencies** - DB, backend services, Server Actions, `server-only`
3. **Test user behavior** - Not implementation details
4. **Query like a user** - `getByRole` / `getByLabel` / `getByText` (RTL `screen.*`, Playwright `page.getBy*`); no CSS or `text=` selectors
5. **`userEvent`, not `fireEvent`** - `const user = userEvent.setup()` then `await user.click(...)` / `user.type(...)`
6. **Async/await** - For async operations
7. **Clear mocks** - In beforeEach

## Completion Checklist

After writing tests:

1. **Run tests**: `{{ stack.quality_gates.tests.command }}`
2. **Ensure all pass**: Zero failures
3. **Check coverage**: Tests cover happy path, edge cases, error cases
