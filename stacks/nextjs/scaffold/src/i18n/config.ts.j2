// Locale set for the landing site. Baked in by buildmate and kept identical to the
// mobile app's i18n config. Add/remove locales via the `languages` option, not here.
export const locales = {{ variables.locales.split(',') | map('trim') | list | tojson }} as const;
export const defaultLocale = "{{ variables.default_locale }}" as const;

export type Locale = (typeof locales)[number];

