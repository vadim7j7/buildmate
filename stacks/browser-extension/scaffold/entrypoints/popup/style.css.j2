{% if variables.use_tailwind %}@import "tailwindcss";

{% endif %}:root {
  color-scheme: light dark;
}

/* Set by the theme toggle in main.ts */
:root[data-theme='light'] {
  color-scheme: light;
}

:root[data-theme='dark'] {
  color-scheme: dark;
}

body {
  margin: 0;
  width: 320px;
  font-family: system-ui, -apple-system, sans-serif;
}

.popup {
  padding: 16px;
}

.popup h1 {
  font-size: 16px;
  margin: 0 0 8px;
}

.tab {
  color: #666;
  font-size: 13px;
  margin: 0 0 12px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

button {
  padding: 8px 12px;
  border: 1px solid #ccc;
  border-radius: 6px;
  background: Canvas;
  color: CanvasText;
  cursor: pointer;
  font: inherit;
}
