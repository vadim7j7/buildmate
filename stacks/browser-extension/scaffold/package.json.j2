{
  "name": "my-extension",
  "description": "Cross-browser extension built with WXT ({{ variables.ui_framework }})",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
{% if variables.ui_framework == 'Vue' %}
    "compile": "wxt prepare && vue-tsc --noEmit",
{% elif variables.ui_framework == 'Svelte' %}
    "compile": "wxt prepare && svelte-check --tsconfig ./tsconfig.json",
{% else %}
    "compile": "wxt prepare && tsc --noEmit",
{% endif %}
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && playwright test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.0"{% if variables.ui_framework == 'React' %},
    "react": "^19.0.0",
    "react-dom": "^19.0.0"{% elif variables.ui_framework == 'Vue' %},
    "vue": "^3.5.0"{% elif variables.ui_framework == 'Svelte' %},
    "svelte": "^5.0.0"{% endif %}

  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.9.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.0",
    "wxt": "^0.21.0"{% if variables.use_tailwind %},
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0"{% endif %}{% if variables.ui_framework == 'React' %},
    "@wxt-dev/module-react": "^1.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"{% elif variables.ui_framework == 'Vue' %},
    "@wxt-dev/module-vue": "^1.0.0",
    "vue-tsc": "^3.0.0"{% elif variables.ui_framework == 'Svelte' %},
    "@wxt-dev/module-svelte": "^2.0.0",
    "svelte-check": "^4.0.0"{% endif %}

  }
}
