{
  "name": "my-extension",
  "description": "Cross-browser extension built with WXT ({{ variables.ui_framework }})",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@webext-core/messaging": "^2.1.0"{% if variables.ui_framework == 'React' %},
    "react": "^18.3.1",
    "react-dom": "^18.3.1"{% elif variables.ui_framework == 'Vue' %},
    "vue": "^3.4.21"{% elif variables.ui_framework == 'Svelte' %},
    "svelte": "^4.2.12"{% endif %}
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0",
    "wxt": "^0.19.0"{% if variables.use_tailwind %},
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0"{% endif %}{% if variables.wxt_module %},
    "{{ variables.wxt_module }}": "^1.1.0"{% endif %}{% if variables.ui_framework == 'React' %},
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"{% endif %}
  }
}
