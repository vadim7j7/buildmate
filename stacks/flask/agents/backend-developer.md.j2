## Code Patterns

Flask is **synchronous**. Flask-SQLAlchemy's `db.session` is a sync session scoped to
the app context: use `db.session.execute(select(...))`, `db.session.get(...)`,
`db.session.commit()`. Never `async with db.session()` / `await` (raises `TypeError`)
and never `async def` views or services. Full examples: `patterns/flask-patterns.md`
and `patterns/backend-patterns.md`.

### App Factory Pattern

```python
# src/app/__init__.py
import os

from flask import Flask

from app.config import CONFIGS
from app.extensions import cors, db, migrate


def create_app(config_name: str | None = None) -> Flask:
    """Create and configure the Flask application."""
    app = Flask(__name__)
    app.config.from_object(CONFIGS[config_name or os.environ.get("APP_ENV", "development")])

    db.init_app(app)
    migrate.init_app(app, db)
    cors.init_app(app)

    @app.get("/health")
    def health() -> dict[str, str]:
        """Liveness check (dev server verification calls it)."""
        return {"status": "ok"}

    from app.blueprints.projects import bp as projects_bp

    app.register_blueprint(projects_bp, url_prefix="/api/projects")
    register_error_handlers(app)
    return app
```

### Blueprint Pattern (sync views)

```python
# src/app/blueprints/projects.py
from flask import Blueprint, Response, jsonify, request

from app.schemas.project import ProjectRead
from app.services.project_service import ProjectService

bp = Blueprint("projects", __name__)


@bp.get("/")
def list_projects() -> Response:
    """List all projects with pagination."""
    skip = request.args.get("skip", 0, type=int)
    limit = min(request.args.get("limit", 20, type=int), 100)
    projects = ProjectService().list(skip=skip, limit=limit)
    return jsonify([ProjectRead.model_validate(p).model_dump(mode="json") for p in projects])


@bp.get("/<int:project_id>")
def get_project(project_id: int) -> Response | tuple[dict[str, str], int]:
    """Get a single project by ID."""
    project = ProjectService().get_by_id(project_id)
    if project is None:
        return {"error": "Project not found"}, 404
    return jsonify(ProjectRead.model_validate(project).model_dump(mode="json"))
```

Boolean query flags: never `request.args.get("x", type=bool)` (`bool("false")` is
`True`); use the `parse_bool` helper from `patterns/flask-patterns.md`.

### Service Pattern (sync)

```python
# src/app/services/project_service.py
from sqlalchemy import select

from app.extensions import db
from app.models.project import Project
from app.schemas.project import ProjectCreate


class ProjectService:
    """Business logic for project operations."""

    def list(self, *, skip: int = 0, limit: int = 20) -> list[Project]:
        """List projects with pagination."""
        stmt = select(Project).order_by(Project.id).offset(skip).limit(limit)
        return list(db.session.execute(stmt).scalars())

    def get_by_id(self, project_id: int) -> Project | None:
        """Get a project by primary key."""
        return db.session.get(Project, project_id)

    def create(self, payload: ProjectCreate, *, owner_id: int) -> Project:
        """Create a new project."""
        project = Project(**payload.model_dump(), owner_id=owner_id)
        db.session.add(project)
        db.session.commit()
        return project
```

### Extensions and Models

```python
# src/app/extensions.py
from flask_cors import CORS
from flask_migrate import Migrate
from flask_sqlalchemy import SQLAlchemy
from sqlalchemy.orm import DeclarativeBase


class Base(DeclarativeBase):
    """Declarative base shared by all models."""


db = SQLAlchemy(model_class=Base)
migrate = Migrate()
cors = CORS()
```

Models subclass `db.Model` with `Mapped[]` / `mapped_column()`; quote related model
names (`Mapped["User"]`).

### Configuration Pattern

Config classes in `src/app/config.py` selected through a `CONFIGS` dict
(`development`, `testing`, `production`); `SECRET_KEY` and `DATABASE_URL` come from
the environment, with fallbacks only in development/testing. The database URL uses
the sync driver for {{ variables.database }}{% if variables.db_url_scheme %} (`{{ variables.db_url_scheme }}://...`){% endif %}.
See `patterns/flask-patterns.md` section 4.

### Schema Pattern (Pydantic v2)

```python
from datetime import datetime

from pydantic import BaseModel, ConfigDict


class ProjectBase(BaseModel):
    """Shared fields for project schemas."""

    name: str
    description: str | None = None


class ProjectCreate(ProjectBase):
    """Schema for creating a project."""


class ProjectRead(ProjectBase):
    """Schema for reading a project (includes DB fields)."""

    model_config = ConfigDict(from_attributes=True)

    id: int
    created_at: datetime
    updated_at: datetime
```

### Error Handler Pattern

```python
from flask import Flask
from pydantic import ValidationError

from app.extensions import db


def register_error_handlers(app: Flask) -> None:
    """Register application error handlers."""

    @app.errorhandler(ValidationError)
    def validation_error(error: ValidationError) -> tuple[dict[str, object], int]:
        return {"errors": error.errors(include_url=False)}, 422

    @app.errorhandler(404)
    def not_found(error: Exception) -> tuple[dict[str, str], int]:
        return {"error": "Not found"}, 404

    @app.errorhandler(500)
    def internal_error(error: Exception) -> tuple[dict[str, str], int]:
        db.session.rollback()
        return {"error": "Internal server error"}, 500
```

## Style Rules (MANDATORY)

1. **No `from __future__ import annotations`** - Python 3.13 has `X | None` natively; Pydantic and SQLAlchemy read annotations at runtime, and the future import makes ruff (TC rules) move runtime-needed imports into `TYPE_CHECKING`. Quote forward references instead (`Mapped["User"]`)
2. **Type annotations** - On all function parameters and return types
3. **Google-style docstrings** - On all public classes and functions
4. **PEP 8** - Enforced by Ruff (line length 88)
5. **f-strings** - For all string formatting
6. **`snake_case`** - For functions, methods, variables
7. **`PascalCase`** - For classes
8. **`str | None`** - Union syntax (not `Optional[str]`)
9. **`list[X]`, `dict[K, V]`** - Lowercase generics (not `typing.List`)
10. **`model_dump()`** - Never use deprecated `.dict()`
11. **`Mapped[]`** - For all SQLAlchemy column types
12. **App factory** - Always use `create_app()` pattern
13. **Blueprints** - Organize routes into blueprints, never use bare `@app.route` (only `/health` lives in the factory)
14. **Sync only** - `def` views and services, `db.session.execute(select(...))`; no `async def`, `await` or `async with db.session()`

