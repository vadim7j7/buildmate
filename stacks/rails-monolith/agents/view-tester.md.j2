## Before Writing Tests

{% include 'base/partials/read-patterns.md.j2' %}

Then look at the existing specs in {% if v.vc or v.phlex %}`spec/components/`{% else %}`spec/views/`{% endif %} and `spec/system/` and follow their structure.

{% if v.vc %}
## ViewComponent Spec

```ruby
# frozen_string_literal: true

require 'rails_helper'

RSpec.describe ProfileCardComponent, type: :component do
  let(:profile) { build_stubbed(:profile, name: 'Ada Lovelace', headline: 'Engineer') }

  it 'renders the profile name' do
    render_inline(described_class.new(profile:))

    expect(page).to have_css('h3', text: 'Ada Lovelace')
  end

  it 'renders the bio when present' do
    profile.bio = 'Mathematician and writer.'
    render_inline(described_class.new(profile:))

    expect(page).to have_text('Mathematician and writer.')
  end

  describe 'size variants' do
    it 'applies the small size class for :sm' do
      render_inline(described_class.new(profile:, size: :sm))
      expect(page).to have_css('article.{{ v.css.size_sm.split(' ') | first }}')
    end
  end
end
```
{% elif v.phlex %}
## Phlex Component Spec

```ruby
# frozen_string_literal: true

require 'rails_helper'

RSpec.describe Components::ProfileCard, type: :component do
  let(:profile) { build_stubbed(:profile, name: 'Ada Lovelace', headline: 'Engineer') }

  def render_component(**)
    Capybara.string(described_class.new(profile:, **).call)
  end

  it 'renders the profile name' do
    expect(render_component).to have_css('h3', text: 'Ada Lovelace')
  end

  it 'applies the small size class for :sm' do
    expect(render_component(size: :sm)).to have_css('article.{{ v.css.size_sm.split(' ') | first }}')
  end
end
```

Components that call Rails helpers (`link_to`, `t`, routes) need a view context:
render them through `ApplicationController.renderer.render(component, layout: false)`
or the `phlex-testing` helpers instead of `#call`.
{% else %}
## Partial Spec

```ruby
# frozen_string_literal: true

require 'rails_helper'

RSpec.describe 'profiles/_card', type: :view do
  let(:profile) { build_stubbed(:profile, name: 'Ada Lovelace', headline: 'Engineer') }

  it 'renders the profile name' do
    render partial: 'profiles/card', locals: { profile: }

    expect(rendered).to have_css('h3', text: 'Ada Lovelace')
  end

  it 'applies the small size class for :sm' do
    render partial: 'profiles/card', locals: { profile:, size: :sm }

    expect(rendered).to have_css('article.{{ v.css.size_sm.split(' ') | first }}')
  end
end
```
{% endif %}

Use `build_stubbed` (not `create`) when the database isn't required — much faster.

{% if v.stim %}
## System Spec (Capybara + JS)

For {% if v.turbo %}Turbo / {% endif %}Stimulus interactions, use a JS driver:

```ruby
# frozen_string_literal: true

require 'rails_helper'

RSpec.describe 'Profile dropdown', type: :system, js: true do
  let(:user) { create(:user) }
  let!(:profile) { create(:profile, user:, name: 'Ada Lovelace') }

  before { sign_in user }

  it 'opens and closes the dropdown' do
    visit profile_path(profile)

    expect(page).not_to have_link('Edit')

    click_button 'Options'
    expect(page).to have_link('Edit')

    # Click outside closes
    find('body').click
    expect(page).not_to have_link('Edit')
  end
end
```
{% else %}
## System Spec (Capybara, no JS)

```ruby
# frozen_string_literal: true

require 'rails_helper'

RSpec.describe 'Profile edit', type: :system do
  let(:user) { create(:user) }
  let!(:profile) { create(:profile, user:, name: 'Old name') }

  before do
    driven_by(:rack_test)
    sign_in user
  end

  it 'updates the profile and redirects back' do
    visit edit_profile_path(profile)
    fill_in 'Name', with: 'New name'
    click_button 'Save'

    expect(page).to have_current_path(profile_path(profile))
    expect(page).to have_text('New name')
  end
end
```
{% endif %}
{% if v.turbo %}

## System Spec for Turbo Frames

```ruby
RSpec.describe 'Profile inline edit', type: :system, js: true do
  let(:user) { create(:user) }
  let!(:profile) { create(:profile, user:, name: 'Old name') }

  before { sign_in user }

  it 'edits inside a Turbo frame without full page reload' do
    visit profile_path(profile)
    click_link 'Edit'

    # Stays on same URL because the frame swap is local
    expect(page).to have_current_path(profile_path(profile))
    fill_in 'Name', with: 'New name'
    click_button 'Save'

    expect(page).to have_text('New name')
    expect(page).not_to have_field('Name')
  end
end
```

## System Spec for Turbo Streams

```ruby
RSpec.describe 'Comment broadcast', type: :system, js: true do
  let(:user) { create(:user) }
  let(:post) { create(:post) }
  before { sign_in user }

  it 'appends new comments without reloading' do
    visit post_path(post)

    fill_in 'Comment', with: 'Great post'
    click_button 'Post'

    expect(page).to have_css('#comments li', text: 'Great post')
    expect(page).not_to have_field('Comment', with: 'Great post') # form was reset
  end
end
```
{% endif %}

## Test Style Rules

{% if v.vc %}
- **Use `render_inline` for components** (NOT controller specs)
{% elif v.phlex %}
- **Render components directly** in component specs (NOT controller specs)
{% else %}
- **Use view specs for partials** with explicit `locals:`
{% endif %}
- **Use `build_stubbed` over `create`** when DB isn't required
- **Assert on visible HTML/text** — not internal markup details
{% if v.stim %}
- **System specs use `js: true`** for {% if v.turbo %}Turbo/{% endif %}Stimulus interactions
{% else %}
- **System specs use `driven_by(:rack_test)`** — the app has no JavaScript
{% endif %}
- **Use semantic finders** — `have_button`, `have_link`, `have_field`, NOT `have_css('button.primary')` everywhere
- **Use `within(...)` to scope** when multiple similar elements exist
- **Test accessibility** — labels, alt text, focus order
- **Factories, not fixtures**
- **One behavior per `it`**

## Accessibility Checks (when relevant)

```ruby
it 'has accessible images' do
  expect(page).to have_css('img[alt]')
end
```
