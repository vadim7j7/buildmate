## ViewComponent Spec

```ruby
# frozen_string_literal: true

require 'rails_helper'

RSpec.describe ProfileCardComponent, type: :component do
  let(:profile) { build_stubbed(:profile, name: 'Ada Lovelace', headline: 'Engineer') }

  it 'renders the profile name' do
    render_inline(described_class.new(profile:))

    expect(page).to have_css('h3', text: 'Ada Lovelace')
  end

  it 'renders the bio when present' do
    profile.bio = 'Mathematician and writer.'
    render_inline(described_class.new(profile:))

    expect(page).to have_text('Mathematician and writer.')
  end

  it 'omits the bio section when blank' do
    profile.bio = nil
    render_inline(described_class.new(profile:))

    expect(page).not_to have_css('p', text: '')
  end

  describe 'size variants' do
    it 'applies w-48 for :sm' do
      render_inline(described_class.new(profile:, size: :sm))
      expect(page).to have_css('article.w-48')
    end

    it 'applies w-full for :lg' do
      render_inline(described_class.new(profile:, size: :lg))
      expect(page).to have_css('article.w-full')
    end
  end
end
```

Use `build_stubbed` (not `create`) when the database isn't required — much faster.

## System Spec (Capybara + JS)

For Turbo / Stimulus interactions, use a JS driver:

```ruby
# frozen_string_literal: true

require 'rails_helper'

RSpec.describe 'Profile dropdown', type: :system, js: true do
  let(:user) { create(:user) }
  let!(:profile) { create(:profile, user:, name: 'Ada Lovelace') }

  before { sign_in user }

  it 'opens and closes the dropdown' do
    visit profile_path(profile)

    expect(page).to have_css('[data-dropdown-target="menu"].hidden')

    click_button 'Options'

    expect(page).not_to have_css('[data-dropdown-target="menu"].hidden')
    expect(page).to have_link('Edit')

    # Click outside closes
    find('body').click
    expect(page).to have_css('[data-dropdown-target="menu"].hidden')
  end
end
```

## System Spec for Turbo Frames

```ruby
RSpec.describe 'Profile inline edit', type: :system, js: true do
  let(:user) { create(:user) }
  let!(:profile) { create(:profile, user:, name: 'Old name') }

  before { sign_in user }

  it 'edits inside a Turbo frame without full page reload' do
    visit profile_path(profile)
    click_link 'Edit'

    # Stays on same URL because the frame swap is local
    expect(page).to have_current_path(profile_path(profile))
    fill_in 'Name', with: 'New name'
    click_button 'Save'

    expect(page).to have_text('New name')
    expect(page).not_to have_field('Name')
  end
end
```

## System Spec for Turbo Streams

```ruby
RSpec.describe 'Comment broadcast', type: :system, js: true do
  let(:user) { create(:user) }
  let(:post) { create(:post) }
  before { sign_in user }

  it 'appends new comments without reloading' do
    visit post_path(post)

    fill_in 'Comment', with: 'Great post'
    click_button 'Post'

    expect(page).to have_css('#comments li', text: 'Great post')
    expect(page).not_to have_field('Comment', with: 'Great post') # form was reset
  end
end
```

## Test Style Rules

1. **Use `render_inline` for components** (NOT controller specs)
2. **Use `build_stubbed` over `create`** when DB isn't required
3. **Assert on visible HTML/text** — not internal markup details
4. **System specs use `js: true`** for Turbo/Stimulus interactions
5. **Use semantic finders** — `have_button`, `have_link`, `have_field`, NOT `have_css('button.primary')` everywhere
6. **Use `within(...)` to scope** when multiple similar elements exist
7. **Test accessibility** — labels, alt text, focus order
8. **Factories, not fixtures**
9. **One behavior per `it`**

## Accessibility Checks (when relevant)

```ruby
it 'has accessible labels' do
  render_inline(described_class.new(profile:))
  expect(page).to have_css('img[alt]')
  expect(page).to have_css('article[aria-labelledby]') # if using aria-labelledby
end
```

## Lookbook Preview

When creating a component, also create a preview for visual testing:

```ruby
# spec/components/previews/profile_card_component_preview.rb
class ProfileCardComponentPreview < ViewComponent::Preview
  def default
    profile = Profile.new(name: 'Ada Lovelace', headline: 'Engineer', bio: 'Sample bio.')
    render(ProfileCardComponent.new(profile:))
  end

  def small
    profile = Profile.new(name: 'Ada Lovelace', headline: 'Engineer')
    render(ProfileCardComponent.new(profile:, size: :sm))
  end
end
```

## Completion Checklist

After writing tests:

1. **Run the tests**: `{{ stack.quality_gates.tests.command }} <spec_files>`
2. **Run system specs separately if slow**: `{{ stack.quality_gates.tests.command }} spec/system/`
3. **Ensure all pass**: Zero failures, zero pending
4. **Verify coverage**: Component variants, edge cases (empty state, error state), and key interactions

Report test results including pass/fail counts.
