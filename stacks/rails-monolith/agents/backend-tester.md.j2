## Request Spec for HTML Controllers

```ruby
# frozen_string_literal: true

require 'rails_helper'

RSpec.describe 'Profiles' do
  let(:user) { create(:user) }
  before { sign_in user }

  describe 'GET /profiles' do
    it 'renders the index page' do
      create_list(:profile, 3, user:)

      get profiles_path

      expect(response).to have_http_status(:ok)
      expect(response.body).to include('Profiles')
    end
  end

  describe 'POST /profiles' do
    context 'with valid params' do
      let(:valid_params) { { profile: { name: 'Test', email: 'test@example.com' } } }

      it 'creates a profile and redirects' do
        expect { post profiles_path, params: valid_params }
          .to change(Profile, :count).by(1)

        expect(response).to redirect_to(profile_path(Profile.last))
        follow_redirect!
        expect(flash[:notice]).to be_present
      end
    end

    context 'with invalid params' do
      let(:invalid_params) { { profile: { name: '' } } }

      it 're-renders new with 422 (Turbo-compatible)' do
        post profiles_path, params: invalid_params

        expect(response).to have_http_status(:unprocessable_entity)
        expect(response.body).to include('error')
      end
    end
  end

  describe 'DELETE /profiles/:id' do
    let!(:profile) { create(:profile, user:) }

    it 'destroys and redirects with 303 (Turbo-compatible)' do
      expect { delete profile_path(profile) }.to change(Profile, :count).by(-1)

      expect(response).to have_http_status(:see_other)
      expect(response).to redirect_to(profiles_path)
    end
  end
end
```

Key Turbo-aware assertions:
- `:unprocessable_entity` (422) on form validation failure (NOT redirect)
- `:see_other` (303) on DELETE redirect

