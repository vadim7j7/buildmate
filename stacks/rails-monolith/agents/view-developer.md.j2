## Code Patterns

{% if v.vc %}
### ViewComponent (sidecar template)

`app/components/profile_card_component.rb`:

```ruby
# frozen_string_literal: true

class ProfileCardComponent < ApplicationComponent
  # @param profile [Profile]
  # @param size [Symbol] :sm, :md, :lg
  def initialize(profile:, size: :md)
    @profile = profile
    @size = size
  end

  private

  attr_reader :profile, :size

  def container_classes
    base = '{{ v.css.card }}'
    size_class = case size
                 when :sm then '{{ v.css.size_sm }}'
                 when :md then '{{ v.css.size_md }}'
                 when :lg then '{{ v.css.size_lg }}'
                 end
    "#{base} #{size_class}"
  end
end
```

`app/components/profile_card_component.html.erb`:

```erb
<article class="<%= container_classes %>">
  <header class="{{ v.css.header }}">
    <%= image_tag profile.avatar_url, class: "{{ v.css.avatar }}", alt: profile.name %>
    <div>
      <h3 class="{{ v.css.name }}"><%= profile.name %></h3>
      <p class="{{ v.css.muted }}"><%= profile.headline %></p>
    </div>
  </header>

  <% if profile.bio.present? %>
    <p class="{{ v.css.body }}"><%= profile.bio %></p>
  <% end %>
</article>
```

Render in a view:

```erb
<%= render(ProfileCardComponent.new(profile: @profile, size: :lg)) %>
```
{% elif v.phlex %}
### Phlex Component

`app/components/profile_card.rb`:

```ruby
# frozen_string_literal: true

module Components
  class ProfileCard < Components::Base
    # @param profile [Profile]
    # @param size [Symbol] :sm, :md, :lg
    def initialize(profile:, size: :md)
      @profile = profile
      @size = size
    end

    def view_template
      article(class: container_classes) do
        header(class: '{{ v.css.header }}') do
          img(src: @profile.avatar_url, class: '{{ v.css.avatar }}', alt: @profile.name)
          div do
            h3(class: '{{ v.css.name }}') { @profile.name }
            p(class: '{{ v.css.muted }}') { @profile.headline }
          end
        end
        p(class: '{{ v.css.body }}') { @profile.bio } if @profile.bio.present?
      end
    end

    private

    def container_classes
      size_class = { sm: '{{ v.css.size_sm }}', md: '{{ v.css.size_md }}', lg: '{{ v.css.size_lg }}' }.fetch(@size)
      "{{ v.css.card }} #{size_class}"
    end
  end
end
```

Render in a view:

```erb
<%= render Components::ProfileCard.new(profile: @profile, size: :lg) %>
```
